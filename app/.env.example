# URL de um diretório estático que contenha meta.json e hotspots.json.
# Deixe vazio para usar apenas o seed embarcado (funciona offline).
# Exemplo: EXPO_PUBLIC_DATA_URL=https://exemplo.com/riskradar
EXPO_PUBLIC_DATA_URL=

# Chave da API de incidentes de trânsito do TomTom (Orbis v2).
# Sem a chave, o app usa apenas os dados históricos da PRF.
# ATENÇÃO: a chave em EXPO_PUBLIC_* fica embutida no bundle. Restrinja o uso
# no painel do TomTom e considere um proxy antes de publicar o app.
EXPO_PUBLIC_TOMTOM_API_KEY=
